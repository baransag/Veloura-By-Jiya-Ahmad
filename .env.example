# VELOURA — Environment Variables

# ─── DATABASE ───────────────────────────────────────────────────────────
# Local development (PostgreSQL 17, Windows)
# DATABASE_URL="postgresql://postgres@localhost:5432/veloura_db?schema=public"

# Production (Neon, Supabase, Railway, or any Postgres provider)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/veloura_db?schema=public"

# ─── AUTHENTICATION ──────────────────────────────────────────────────────
# Generate a secure secret: openssl rand -base64 32
JWT_SECRET="REPLACE_WITH_STRONG_RANDOM_SECRET"

# ─── APP URL ─────────────────────────────────────────────────────────────
# Set to your Vercel production URL after deployment
NEXT_PUBLIC_APP_URL="https://YOUR-PROJECT-NAME.vercel.app"
